[Unit]
Description=LiteOps - Lightweight Data Operations Workbench
After=network.target

[Service]
Type=simple
User=liteops
Group=liteops
WorkingDirectory=/opt/liteops
EnvironmentFile=/etc/liteops/liteops.env
ExecStart=/opt/liteops/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
